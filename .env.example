PORT=3000
MODE=DEV
RUN_MIGRATIONS=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TTL=60
REDIS_URL=redis://localhost:6379
PRODUCT_LIST_CACHE_TTL_MS=60000
PRODUCT_SINGLE_CACHE_TTL_MS=300000
RABBITMQ_URL=amqp://admin:admin123@127.0.0.1:5672
RABBITMQ_QUEUE=ecommerce.infra
JWT_SECRET=change-me-please
JWT_EXPIRES_IN=15m
RESET_TOKEN_TTL=15m
RESET_TOKEN_CLEANUP_DAYS=7
OTP_TTL=5m
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=60s
WHATSAPP_PROVIDER=noop
WHATSAPP_FROM_NUMBER=+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:3000
# Phase 5 Reservation Expiration Cleanup (specs/006-reservation-expiration-cleanup)
EXPIRATION_INTERVAL_MS=30000
EXPIRATION_BATCH_SIZE=10
EXPIRATION_ENABLED=true
EXPIRATION_MAX_RETRIES=3
# Phase 11 Transactional Outbox (specs/011-async-events-notifications)
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_PROCESSING_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
OUTBOX_RETENTION_DAYS=30
# Phase 10 Rate Limiting (specs/010-rate-limiting)
ORDER_CHECKOUT_RL_MAX=10
ORDER_CHECKOUT_RL_WINDOW_MS=3600000
ORDER_COMPLETE_RL_MAX=10
ORDER_COMPLETE_RL_WINDOW_MS=3600000
CART_RL_MAX=60
CART_RL_WINDOW_MS=3600000
PRODUCT_MUTATION_RL_MAX=30
PRODUCT_MUTATION_RL_WINDOW_MS=3600000
RATE_LIMIT_FAIL_OPEN_METRIC=auth_rate_limit_fallback_total
# Phase 17 Refresh Token (specs/013-refresh-token)
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_RL_MAX=10
REFRESH_RL_WINDOW_MS=3600000
REFRESH_HASH_RL_MAX=5
REFRESH_HASH_RL_WINDOW_MS=3600000
LOGOUT_RL_MAX=20
LOGOUT_RL_WINDOW_MS=3600000
LOGOUT_ALL_RL_MAX=10
LOGOUT_ALL_RL_WINDOW_MS=3600000
# Phase 18 Email Service — Resend SMTP (specs/014-email-service) https://resend.com/docs/send-with-nodemailer-smtp
EMAIL_PROVIDER=resend
EMAIL_FROM="Mini E-Commerce <onboarding@resend.dev>"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_SECURE=true
EMAIL_VERIFICATION_TTL=24h
EMAIL_RESET_TTL=15m
EMAIL_SALES_BATCH_SIZE=500
WS_AUTH=true
NOTIFICATION_HISTORY_PAGE_SIZE=20
